APP_URL=http://localhost:3000
APP_OWNER_EMAIL=
SUPABASE_URL=https://uhbwpdtmcawlrdkmqdgc.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Supabase Secret key (sb_secret_...) or legacy service_role JWT
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes encoded as 64 hex characters
ENCRYPTION_KEY=
CRON_SECRET=
META_API_VERSION=v25.0
LINKEDIN_API_VERSION=202609
# Extra exact OAuth callbacks; ChatGPT and Claude callbacks are built in
MCP_ALLOWED_REDIRECT_URIS=
WORDPRESS_ALLOWED_HOSTS=

# --- Self-hosted mode (VPS, Coolify): PostgreSQL instead of Supabase -------------
# With DATABASE_URL set, MCPLinker uses PostgreSQL directly: local sign-in, files in
# the database (served at APP_URL/media/...) and a built-in scheduler every minute.
# Leave SUPABASE_* empty in this mode. See docs/VPS.md.
DATABASE_URL=
# Optional one-time copy from a previous Supabase deployment (secret key, server only)
SOURCE_SUPABASE_URL=
SOURCE_SUPABASE_SERVICE_ROLE_KEY=
SOURCE_SUPABASE_PUBLISHABLE_KEY=
# copy (default: scheduled posts become drafts, automations off) or cutover
IMPORT_MODE=copy
# Optional owner password for this installation (at least 12 characters); applied at startup
APP_OWNER_PASSWORD=
# Set to 1 to stop the built-in scheduler (e.g. a second instance on the same database)
SCHEDULER_DISABLED=
